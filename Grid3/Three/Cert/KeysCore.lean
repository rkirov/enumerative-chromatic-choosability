import Grid3.Three.Cert.Checker

/-!
# Seam keys: validity, maximality, and a complete enumeration (kernel-evaluable core)

A seam key is `(mL, mR, M)`: two packed column types and a packed `7 × 7` matrix of matched-pair
counts (`Checker.lean` fixes the packings: `mult`, `mcount`). The key is *valid* when matches only
join intersecting patterns and the row/column sums respect the multiplicities, and *maximal* when
no further match is possible: every intersecting pair `(p, q)` has its left row or its right
column saturated. Maximality is what a concrete seam can always reach (extend the partial block
matching), and validity plus maximality is exactly what the certificate generator enumerated.

`enumKeys mL mR` lists every valid maximal `M` for the pair, row by row. Each row vector comes
from a literal table `rowVecsLit` (identified with the structural generator `comps` by a kernel
check in `Keys.lean`), tagged with its base-8 repacking and with the mask of the columns it
intersects when it leaves a spare left colour. The residual column capacities are one base-8
packed `Nat` with a guard bit per digit, so that "fits digitwise" is `((res + G8) - r8) &&& G8 = G8`
and the update is a subtraction; the spare rows accumulate a mask `dead`, and maximality is the
final test `res &&& dead = 0`. `Keys.lean` proves that every valid maximal key is listed
(`enumKeys_complete`); the per-pair modules `Keys/K*.lean` identify the list with the stored
record keys by `decide +kernel`.

No Mathlib import: everything here is evaluated by the kernel in the per-pair modules.
-/

namespace Grid3.Three.Cert

/-! ### Validity and maximality of a packed key -/

/-- patterns `p + 1` and `q + 1` share a row -/
def inter (p q : Nat) : Bool := (p + 1) &&& (q + 1) != 0

/-- matches only on intersecting patterns; row sums within `mL`; column sums within `mR` -/
def validKey (mL mR M : Nat) : Bool :=
  (List.range 7).all (fun p => (List.range 7).all fun q => inter p q || mcount M p q == 0)
  && (List.range 7).all (fun p => sumRow M p ≤ mult mL p)
  && (List.range 7).all (fun q => sumCol M q ≤ mult mR q)

/-- no intersecting pair has both a spare left colour and a spare right colour -/
def keyMax (mL mR M : Nat) : Bool :=
  (List.range 7).all fun p => (List.range 7).all fun q =>
    !inter p q || sumRow M p == mult mL p || sumCol M q == mult mR q

/-! ### Row vectors -/

/-- base-4 digit `q` of a packed row vector (the same packing as `mult`) -/
def digit (r q : Nat) : Nat := (r / 4 ^ q) % 4

/-- base-8 digit `q` -/
def digit8 (t q : Nat) : Nat := (t / 8 ^ q) % 8

/-- row `p` of `M`, as a packed 7-digit row vector -/
def rowOf (M p : Nat) : Nat := (M / 16384 ^ p) % 16384

/-- the digit sum of a packed row vector -/
def digitSum (r : Nat) : Nat := (List.range 7).foldl (fun acc q => acc + digit r q) 0

/-- the base-8 repacking of a base-4 row vector -/
def toBase8 (r : Nat) : Nat := (List.range 7).foldl (fun acc q => acc + digit r q * 8 ^ q) 0

/-- the guard bits: digit `4` in every base-8 position -/
def G8 : Nat := 1198372

/-- the columns intersecting pattern `p`, as a base-8 mask with digits `7` -/
def colMask8 (p : Nat) : Nat :=
  (List.range 7).foldl (fun acc q => if inter p q then acc + 7 * 8 ^ q else acc) 0

/-- row vectors for pattern `p` on the columns `< n`, with digit sum `≤ rem`: the structural
generator (the specification; `comps_complete` in `Keys.lean`) -/
def comps (p : Nat) : Nat → Nat → List Nat
  | 0, _ => [0]
  | n + 1, rem =>
    if inter p n then
      (List.range (rem + 1)).flatMap fun u => (comps p n (rem - u)).map fun v => v + u * 4 ^ n
    else comps p n rem

/-- the tag of a row vector: its base-8 repacking and, when it leaves a spare left colour, the
mask of the columns it intersects -/
def tagRow (p cap r : Nat) : Nat × Nat × Nat :=
  (r, toBase8 r, if digitSum r < cap then colMask8 p else 0)

