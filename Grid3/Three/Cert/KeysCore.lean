/-- the row-vector lists of rows `p, …, p + n - 1` of the left type -/
def rowLists (mL : Nat) : Nat → Nat → List (List (Nat × Nat × Nat))
  | 0, _ => []
  | n + 1, p => rowVecsLit p (mult mL p) :: rowLists mL n (p + 1)

/-! ### The enumerator -/

/-- packed matrices whose successive rows come from the lists `rvs`, fit the base-8 residual `res`
digitwise, and end with no residual on a column intersecting a spare row (`dead`); the result is
`r_0 + 16384 · (r_1 + 16384 · …)` -/
def enumRows : List (List (Nat × Nat × Nat)) → Nat → Nat → List Nat
  | [], res, dead => if res &&& dead == 0 then [0] else []
  | rv :: rvs, res, dead => rv.flatMap fun e =>
      if (res + G8 - e.2.1) &&& G8 == G8 then
        (enumRows rvs (res - e.2.1) (dead ||| e.2.2)).map fun rest => e.1 + 16384 * rest
      else []

/-- every valid maximal key for the pair `(mL, mR)` -/
def enumKeys (mL mR : Nat) : List Nat := enumRows (rowLists mL 7 0) (toBase8 mR) 0

