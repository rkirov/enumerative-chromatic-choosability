    simp only [Finset.mem_filter, Finset.mem_inter, bit_typ_X, bit_typ_Z, bit_typ_T, bit_typ_M,
      bit_typ_B]
    constructor
    · intro h; exact ⟨mem_univ5_of_X (by tauto), by tauto⟩
