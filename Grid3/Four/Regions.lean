    · intro h; exact ⟨mem_univ5_of_X (by tauto), by tauto⟩
    · intro h; tauto)]
  simp only [Finset.sum_filter, Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num [bit]

theorem card_om (X Z T M B E : Finset ℕ) :
    ((T.filter (· ∉ B)).card : ℤ) = atom X Z T M B E 4 + atom X Z T M B E 5 + atom X Z T M B E 6 + atom X Z T M B E 7 + atom X Z T M B E 12 + atom X Z T M B E 13 + atom X Z T M B E 14 + atom X Z T M B E 15 + (((T.filter (· ∉ B)) ∩ E).card : ℤ) := by
  rw [card_region X Z T M B (fun v => bit v 2 ∧ ¬ bit v 4) (T.filter (· ∉ B)) E (fun c => by
    simp only [Finset.mem_filter, Finset.mem_inter, bit_typ_X, bit_typ_Z, bit_typ_T, bit_typ_M,
      bit_typ_B]
    constructor
    · intro h; exact ⟨mem_univ5_of_T (by tauto), by tauto⟩
    · intro h; tauto)]
  simp only [Finset.sum_filter, Finset.sum_range_succ, Finset.sum_range_zero]
  norm_num [bit]

end Four
