theorem MOBP_eq : MOBP = MOBT.map (List.map mobE) := by decide +kernel

/-- `Σ N_q · c⁺` from the packed sizes `I`. -/
def sumP (I : ℕ) (L : List (List ℕ × ℕ × ℕ)) : ℕ :=
  List.rec (motive := fun _ => ℕ) 0 (fun x _ acc => Nat.add (Nat.mul (nvqF I x.1) x.2.1) acc) L

/-- `Σ N_q · c⁻` from the packed sizes `I`. -/
def sumN (I : ℕ) (L : List (List ℕ × ℕ × ℕ)) : ℕ :=
  List.rec (motive := fun _ => ℕ) 0 (fun x _ acc => Nat.add (Nat.mul (nvqF I x.1) x.2.2) acc) L

/-- **The fast uniform check** at one canonical pattern. -/
def uOKF (c : T6) : Bool :=
  tabF (umask (r1 c)) (umask (r2 c)) (umask (r3 c)) (umask (r4 c)) (umask (r5 c)) (umask (r6 c))
    fun T => xN (horF T 0 64) fun I => (List.range 32).all fun o =>
      Nat.beq (sumP I (MOBP.getD o []))
        (Nat.add (sumN I (MOBP.getD o [])) ((VL.getD (orb c) []).getD o 0))

theorem sumPN_eq (ms : List ℕ) : ∀ L : List (T6 × List Bool × ℤ),
    ((sumP (itab ms) (L.map mobE) : ℕ) : ℤ) - (sumN (itab ms) (L.map mobE) : ℕ)
      = (L.map fun x => x.2.2 * (Nq x.1 ms : ℤ)).sum
  | [] => by simp [sumP, sumN]
  | x :: L => by
    have ih := sumPN_eq ms L
    have e : nvqF (itab ms) (mobE x).1 = Nq x.1 ms := by
      rw [nvqF_eq]; exact nvq_eq ms x.1
    show ((Nat.add (Nat.mul (nvqF (itab ms) (mobE x).1) (mobE x).2.1)
        (sumP (itab ms) (L.map mobE)) : ℕ) : ℤ)
      - ((Nat.add (Nat.mul (nvqF (itab ms) (mobE x).1) (mobE x).2.2)
        (sumN (itab ms) (L.map mobE)) : ℕ) : ℤ) = _
    rw [e, List.map_cons, List.sum_cons, ← ih]
    have hc : ((x.2.2.toNat : ℕ) : ℤ) - ((-x.2.2).toNat : ℕ) = x.2.2 := Int.toNat_sub_toNat_neg _
    simp only [mobE, Nat.add_eq, Nat.mul_eq]
    push_cast
    linear_combination (Nq x.1 ms : ℤ) * hc

theorem umask_lt (x : ℕ) : umask x < 256 := by
  unfold umask; exact lt_of_le_of_lt (Nat.sub_le _ _) (by norm_num)

theorem uOK_of_F {c : T6} (h : uOKF c = true) : uOK c = true := by
  have hlt : ∀ r, (ums c).getD r 0 < 256 := by
    intro r
    match r with
    | 0 => exact umask_lt _
    | 1 => exact umask_lt _
    | 2 => exact umask_lt _
    | 3 => exact umask_lt _
    | 4 => exact umask_lt _
    | 5 => exact umask_lt _
    | _ + 6 => simp [ums]
  have e1 : dblF (dblF (dblF (dblF (dblF (dblF 255 (umask (r1 c)) 0) (umask (r2 c)) 1)
      (umask (r3 c)) 2) (umask (r4 c)) 3) (umask (r5 c)) 4) (umask (r6 c)) 5
      = pk 8 (atL (ums c) 6) := tab_eq (ums c) hlt
  unfold uOKF tabF at h
  simp only [xN_eq] at h
  rw [e1, hor_eq] at h
  unfold uOK
  rw [List.all_eq_true] at h ⊢
  intro o ho
  have k := h o ho
  rw [Nat.beq_eq] at k
  have hm : MOBP.getD o [] = (MOBT.getD o []).map mobE := by
    rw [MOBP_eq, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
    cases (MOBT[o]?) <;> rfl
  rw [hm] at k
  rw [decide_eq_true_eq, cntO, ← sumPN_eq (ums c), k]
  simp only [Nat.add_eq]
  push_cast
  ring

theorem uOKF_0 : (canons.take 26).all uOKF = true := by decide +kernel
theorem uOKF_1 : (canons.drop 26).all uOKF = true := by decide +kernel

theorem uOK_all : ∀ c ∈ canons, uOK c = true := by
  intro c hc
  rw [← List.take_append_drop 26 canons] at hc
  rcases List.mem_append.mp hc with h | h
  · exact uOK_of_F (List.all_eq_true.mp uOKF_0 c h)
  · exact uOK_of_F (List.all_eq_true.mp uOKF_1 c h)

/-- On proper columns the canonical realisation is the first-occurrence string. -/
theorem canon_eq_foT {s : T6} (hs : Proper s) : canon s = foT s := by
  obtain ⟨p1, p2, p3, p4, p5⟩ := hs
  have e0 : fo s 0 = 0 := by unfold fo; simp
  have e1 : fo s 1 = 1 := by
    unfold fo; simp only [rowAt]; rw [ite_eq_right p1, ite_eq_left trivial]
  have e2 : fo s 2 = if r3 s = r1 s then 0 else 2 := by
    unfold fo; simp only [rowAt]
    by_cases h1 : r3 s = r1 s
    · rw [ite_eq_left h1.symm, ite_eq_left h1]
    · rw [ite_eq_right (Ne.symm h1), ite_eq_right h1, ite_eq_right p2, ite_eq_left trivial]
  have e3 : fo s 3 = if r4 s = r1 s then 0 else if r4 s = r2 s then 1 else 3 := by
    unfold fo; simp only [rowAt]
    by_cases h1 : r4 s = r1 s
    · rw [ite_eq_left h1.symm, ite_eq_left h1]
    rw [ite_eq_right (Ne.symm h1), ite_eq_right h1]
    by_cases h2 : r4 s = r2 s
    · rw [ite_eq_left h2.symm, ite_eq_left h2]
    · rw [ite_eq_right (Ne.symm h2), ite_eq_right h2, ite_eq_right p3, ite_eq_left trivial]
  have e4 : fo s 4 = if r5 s = r1 s then 0 else if r5 s = r2 s then 1 else if r5 s = r3 s then 2
      else 4 := by
    unfold fo; simp only [rowAt]
    by_cases h1 : r5 s = r1 s
    · rw [ite_eq_left h1.symm, ite_eq_left h1]
    rw [ite_eq_right (Ne.symm h1), ite_eq_right h1]
    by_cases h2 : r5 s = r2 s
    · rw [ite_eq_left h2.symm, ite_eq_left h2]
    rw [ite_eq_right (Ne.symm h2), ite_eq_right h2]
    by_cases h3 : r5 s = r3 s
    · rw [ite_eq_left h3.symm, ite_eq_left h3]
    · rw [ite_eq_right (Ne.symm h3), ite_eq_right h3, ite_eq_right p4, ite_eq_left trivial]
  have e5 : fo s 5 = if r6 s = r1 s then 0 else if r6 s = r2 s then 1 else if r6 s = r3 s then 2
      else if r6 s = r4 s then 3 else 5 := by
    unfold fo; simp only [rowAt]
    by_cases h1 : r6 s = r1 s
    · rw [ite_eq_left h1.symm, ite_eq_left h1]
    rw [ite_eq_right (Ne.symm h1), ite_eq_right h1]
    by_cases h2 : r6 s = r2 s
    · rw [ite_eq_left h2.symm, ite_eq_left h2]
    rw [ite_eq_right (Ne.symm h2), ite_eq_right h2]
    by_cases h3 : r6 s = r3 s
    · rw [ite_eq_left h3.symm, ite_eq_left h3]
    rw [ite_eq_right (Ne.symm h3), ite_eq_right h3]
    by_cases h4 : r6 s = r4 s
    · rw [ite_eq_left h4.symm, ite_eq_left h4]
    · rw [ite_eq_right (Ne.symm h4), ite_eq_right h4, ite_eq_right p5]
  simp only [canon, foT, e0, e1, e2, e3, e4, e5]

/-- The canonical realisation of a proper column is one of the fifty-two canonical patterns. -/
theorem canon_mem {s : T6} (hs : Proper s) : canon s ∈ canons := by
  rw [canon_eq_foT hs, canons_eq, List.mem_filter]
  exact ⟨foT_mem_PART s, (properB_iff _).mpr ((proper_foT_iff s).mpr hs)⟩

/-- **A weighted count is a combination of orbit counts.** -/
theorem G_eq_sum_orb (w : Wt6) (A B C D E F : Finset ℕ) :
    G w A B C D E F = ∑ o, (((sts A B C D E F).filter (fun t => orb t = o)).card : ℝ) * w o := by
  unfold G gw
  rw [← Finset.sum_fiberwise (sts A B C D E F) orb (fun t => w (orb t))]
  refine Finset.sum_congr rfl fun o _ => ?_
  rw [Finset.sum_congr rfl (fun t ht => by rw [(Finset.mem_filter.mp ht).2]), Finset.sum_const,
    nsmul_eq_mul]

/-- The reduced uniform transfer, row `i`, applied to the weights. -/
noncomputable def rowV6 (i : Fin 32) (w : Wt6) : ℝ := ∑ j, (Vmat6 i j : ℝ) * w j

theorem rowsIn_canon_lt {s : T6} : r1 (canon s) < 6 ∧ r2 (canon s) < 6 ∧ r3 (canon s) < 6 ∧
    r4 (canon s) < 6 ∧ r5 (canon s) < 6 ∧ r6 (canon s) < 6 := by
  have h := rowsIn_canon (k := 6) le_rfl s
  simp only [RowsIn, Finset.mem_range] at h
  exact h

/-- **The uniform successors at `k = 6`**: a proper column in orbit `i` has weighted uniform
successor count `rowV6 i w`. -/
theorem GU_six (w : Wt6) {s : T6} (hs : Proper s) : GU 6 w s = rowV6 (orb s) w := by
  have hc := uOK_all _ (canon_mem hs)
  obtain ⟨l1, l2, l3, l4, l5, l6⟩ := rowsIn_canon_lt (s := s)
  unfold GU
  rw [range_erase_mask l1, range_erase_mask l2, range_erase_mask l3, range_erase_mask l4,
    range_erase_mask l5, range_erase_mask l6, G_eq_sum_orb, rowV6, orb_congr (samePat_canon hs)]
  refine Finset.sum_congr rfl fun o _ => ?_
  have h := card_orb_setOf (ums (canon s)) o
  have hv := List.all_eq_true.mp hc o (List.mem_range.mpr o.2)
  rw [decide_eq_true_eq] at hv
  rw [hv] at h
  have h' : (((sts (setOf (umask (r1 (canon s)))) (setOf (umask (r2 (canon s))))
      (setOf (umask (r3 (canon s)))) (setOf (umask (r4 (canon s)))) (setOf (umask (r5 (canon s))))
      (setOf (umask (r6 (canon s))))).filter (fun t => orb t = o)).card : ℝ)
      = (Vmat6 (orb (canon s)) o : ℝ) := by exact_mod_cast h
  rw [h']

end GridGen.Six
