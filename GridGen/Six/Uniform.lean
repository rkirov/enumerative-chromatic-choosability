/-- The mask of `{0, …, 5} ∖ {x}`. -/
def umask (x : ℕ) : ℕ := 63 - 2 ^ x

theorem range_erase_mask {x : ℕ} (hx : x < 6) : (range 6).erase x = setOf (umask x) := by
  interval_cases x <;> decide

/-- The masks of the uniform successor lists of `c`. -/
def ums (c : T6) : List ℕ := [umask (r1 c), umask (r2 c), umask (r3 c), umask (r4 c), umask (r5 c),
  umask (r6 c)]

/-- The uniform check at one canonical pattern. -/
def uOK (c : T6) : Bool :=
  (List.range 32).all fun o => decide (cntO o (ums c) = ((VL.getD (orb c) []).getD o 0 : ℤ))

/-! ### The uniform check, fast

The kernel checks `uOK` through `uOKF`: the sizes of all intersections of the six masks packed
once per pattern (`tabF`, `horF`), and the Möbius sums with primitive operations, positive and
negative parts apart (`MOBP`, `sumP`, `sumN`). -/

/-- The packed form of a Möbius entry: the block masks, the positive and negative parts of the
coefficient. -/
def mobE (x : T6 × List Bool × ℤ) : List ℕ × ℕ × ℕ := (bms x.1, x.2.2.toNat, (-x.2.2).toNat)

