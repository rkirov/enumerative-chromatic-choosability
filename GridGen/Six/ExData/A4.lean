    (h₂ : 5 ≤ X₂.card) (h₃ : 5 ≤ X₃.card) (h₄ : 5 ≤ X₄.card) (h₅ : 5 ≤ X₅.card)
    (h₆ : 5 ≤ X₆.card) {U V : Finset ℕ} (hU : U.card = 6) (hV : V.card = 6)
