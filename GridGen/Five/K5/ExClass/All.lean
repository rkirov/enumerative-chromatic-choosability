/-! ### The class `(1, 1, 1, 1)`: the seam -/

set_option maxHeartbeats 4000000 in
theorem disp_1111 {B₁ B₂ B₃ B₄ B₅ : Finset ℕ} (hB₁ : B₁.card = 5) (hB₂ : B₂.card = 5)
    (hB₃ : B₃.card = 5) (hB₄ : B₄.card = 5) (hB₅ : B₅.card = 5)
    (c2 : (B₁ ∩ B₂).card + 1 = 5) (c3 : (B₂ ∩ B₃).card + 1 = 5)
    (c4 : (B₃ ∩ B₄).card + 1 = 5) (c5 : (B₄ ∩ B₅).card + 1 = 5) :
    ∃ sp ∈ tbl_1111, AtomsMatch sp.toSpec5 B₁ B₂ B₃ B₄ B₅ ∨ AtomsMatch sp.toSpec5 B₅ B₄ B₃ B₂ B₁ := by
  refine dispatch_of_searchS tbl_1111 szs_1111 eqs_1111 ord_1111 szs_1111_ok disp_dec_1111 ?_
    (atoms_lt7_5 hB₁ hB₂ hB₃ hB₄ hB₅)
  obtain ⟨l1, l2, l3, l4, l5, l12, l23, l34, l45⟩ := venn_lin B₁ B₂ B₃ B₄ B₅
  intro c hc
  simp only [eqs_1111, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · dsimp only [lsum]; clear * - l1 l12 hB₁ c2; omega
  · dsimp only [lsum]; clear * - l2 l12 hB₂ c2; omega
  · dsimp only [lsum]; clear * - l2 l23 hB₂ c3; omega
  · dsimp only [lsum]; clear * - l3 l23 hB₃ c3; omega
  · dsimp only [lsum]; clear * - l3 l34 hB₃ c4; omega
  · dsimp only [lsum]; clear * - l4 l34 hB₄ c4; omega
  · dsimp only [lsum]; clear * - l4 l45 hB₄ c5; omega
  · dsimp only [lsum]; clear * - l5 l45 hB₅ c5; omega
  · exact (lsum_rows B₁ B₂ B₃ B₄ B₅).1.trans hB₁
  · exact (lsum_rows B₁ B₂ B₃ B₄ B₅).2.1.trans hB₂
  · exact (lsum_rows B₁ B₂ B₃ B₄ B₅).2.2.1.trans hB₃
  · exact (lsum_rows B₁ B₂ B₃ B₄ B₅).2.2.2.1.trans hB₄
  · exact (lsum_rows B₁ B₂ B₃ B₄ B₅).2.2.2.2.trans hB₅

/-- **The seam inequality on the class `(1, 1, 1, 1)`.** -/
theorem seam_cls_1111 {w : Wt5} (hw : InCone5 w) {X₁ X₂ X₃ X₄ X₅ B₁ B₂ B₃ B₄ B₅ : Finset ℕ}
    (h₁ : 4 ≤ X₁.card) (h₂ : 4 ≤ X₂.card) (h₃ : 4 ≤ X₃.card) (h₄ : 4 ≤ X₄.card)
    (h₅ : 4 ≤ X₅.card) (hB₁ : B₁.card = 5) (hB₂ : B₂.card = 5) (hB₃ : B₃.card = 5)
    (hB₄ : B₄.card = 5) (hB₅ : B₅.card = 5)
    (c2 : (B₁ ∩ B₂).card + 1 = 5) (c3 : (B₂ ∩ B₃).card + 1 = 5)
    (c4 : (B₃ ∩ B₄).card + 1 = 5) (c5 : (B₄ ∩ B₅).card + 1 = 5) :
    ∑ s ∈ sts X₁ X₂ X₃ X₄ X₅, GU 5 w s ≤ ∑ s ∈ sts X₁ X₂ X₃ X₄ X₅, GB w B₁ B₂ B₃ B₄ B₅ s := by
  obtain ⟨sp, hsp, hA | hA⟩ := disp_1111 hB₁ hB₂ hB₃ hB₄ hB₅ c2 c3 c4 c5
  · exact exact_seam55 (tbl_1111_pass sp hsp) hB₁ hB₂ hB₃ hB₄ hB₅ hA hw h₁ h₂ h₃ h₄ h₅
  · exact seam_of_rev55
      (exact_seam55 (tbl_1111_pass sp hsp) hB₅ hB₄ hB₃ hB₂ hB₁ hA hw h₅ h₄ h₃ h₂ h₁)

