/-- The final inequality from rational bounds. -/
theorem fin_of {Kb gl : ℝ} {γ : ℝ} {ℓ : ℕ → ℝ} {m2 m3 m4 m5 : ℕ} {rho : List (ℕ × ℕ)}
    (hK : Kb ≤ Kbar) (hg : gl ≤ log γ)
    (hl : ∀ k < 11, ℓ k ≤ log ((rhoN rho k : ℝ) / rhoD rho k))
    (hb : ∀ k < 11, 0 ≤ bnd m2 m3 m4 m5 k)
    (hnum : 0 ≤ Kb + gl + ∑ k ∈ range 11, bnd m2 m3 m4 m5 k * ℓ k) :
    0 ≤ Kbar + log γ + ∑ k ∈ range 11, bnd m2 m3 m4 m5 k * log ((rhoN rho k : ℝ) / rhoD rho k) := by
  have : ∑ k ∈ range 11, bnd m2 m3 m4 m5 k * ℓ k
      ≤ ∑ k ∈ range 11, bnd m2 m3 m4 m5 k * log ((rhoN rho k : ℝ) / rhoD rho k) :=
    Finset.sum_le_sum fun k hk => mul_le_mul_of_nonneg_left (hl k (Finset.mem_range.mp hk))
      (hb k (Finset.mem_range.mp hk))
  linarith

theorem bnd_nonneg (m2 m3 m4 m5 k : ℕ) : 0 ≤ bnd m2 m3 m4 m5 k := by
  have qe0 : (0 : ℝ) ≤ qe5 := by unfold qe5; norm_num
  have qm0 : (0 : ℝ) ≤ qm5 := by unfold qm5; norm_num
  unfold bnd
  split <;> first
    | exact le_min (mul_nonneg qe0 (by positivity)) zero_le_one
    | exact le_min (mul_nonneg qm0 (by positivity)) zero_le_one
    | exact le_rfl

