/-!
# Height five, `k = 6`: the shapes of the exact quads, common part

Generated by `ai_research_notes/h5k6/gen5lean.py`. Five `6`-lists with consecutive mismatches
`(μ₂, μ₃, μ₄, μ₅)` one of the thirteen quads below (one per reflection class of `exactQuads5`)
have the atom sizes of one of the certificates in `table5` (`dispatch_μ`). The atom sizes satisfy
nine linear equations (`venn_lin`); the solutions are enumerated by kernel evaluation,
pruning on partial sums (`search`, complete by `search_sound`), and each is found in the table.
The per-quad dispatch theorems are in `Small5/Disp_μ.lean`.
-/

namespace GridGen.Five.Ex5

/-- `f 0 && f 1 && … && f (n - 1)`. -/
def ball5 : ℕ → (ℕ → Bool) → Bool
  | 0, _ => true
  | n + 1, f => ball5 n f && f n

theorem ball5_spec {n : ℕ} {f : ℕ → Bool} (h : ball5 n f = true) (x : ℕ) (hx : x < n) :
    f x = true := by
  induction n with
  | zero => omega
  | succ n ih =>
    simp only [ball5, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hx with hx | rfl
    · exact ih h.1 hx
    · exact h.2

theorem imp5_spec {a b : Bool} (h : (!a || b) = true) (ha : a = true) : b = true := by
  subst ha; simpa using h

theorem vsumI_1 (f : ℕ → ℕ) : vsumI 1 f = f 1 + f 3 + f 5 + f 7 + f 9 + f 11 + f 13 + f 15
    + f 17 + f 19 + f 21 + f 23 + f 25 + f 27 + f 29 + f 31 := by
