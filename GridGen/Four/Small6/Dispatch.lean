import GridGen.Four.Small6.Table

/-!
# Height four, `k = 6`: the shapes of the small mismatch triples

Generated by `ai_research_notes/h4k6/gen6lean.py`. Four `6`-lists with consecutive mismatches
`(μ₂, μ₃, μ₄)` (`μᵢ = 6 - |Bᵢ₋₁ ∩ Bᵢ|`) one of the sixteen triples `ExactTriple6` have the atom
sizes of one of the certificates in `table6` (`dispatch6`). The atom sizes satisfy seven linear
equations (`venn_lin`); `dispatch6_dec` enumerates their solutions by kernel evaluation, pruning on
partial sums, and finds each in the table.
-/

namespace GridGen.Four

/-- The mismatch triples with exact certificates at `k = 6`. -/
def ExactTriple6 (m2 m3 m4 : ℕ) : Prop :=
  (m2 = 0 ∧ m3 = 0 ∧ m4 = 1) ∨
    (m2 = 0 ∧ m3 = 0 ∧ m4 = 2) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 0) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 1) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 2) ∨
    (m2 = 0 ∧ m3 = 2 ∧ m4 = 0) ∨
    (m2 = 0 ∧ m3 = 2 ∧ m4 = 1) ∨
    (m2 = 0 ∧ m3 = 2 ∧ m4 = 2) ∨
    (m2 = 0 ∧ m3 = 3 ∧ m4 = 0) ∨
    (m2 = 0 ∧ m3 = 3 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 0 ∧ m4 = 0) ∨
    (m2 = 1 ∧ m3 = 0 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 1 ∧ m4 = 0) ∨
    (m2 = 1 ∧ m3 = 1 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 2 ∧ m4 = 0) ∨
    (m2 = 2 ∧ m3 = 0 ∧ m4 = 0)

instance (m2 m3 m4 : ℕ) : Decidable (ExactTriple6 m2 m3 m4) := by
  unfold ExactTriple6; infer_instance

/-- `f 0 && f 1 && … && f (n - 1)`. -/
def ball6 : ℕ → (ℕ → Bool) → Bool
  | 0, _ => true
  | n + 1, f => ball6 n f && f n

theorem ball6_spec {n : ℕ} {f : ℕ → Bool} (h : ball6 n f = true) (x : ℕ) (hx : x < n) :
    f x = true := by
  induction n with
  | zero => omega
  | succ n ih =>
    simp only [ball6, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hx with hx | rfl
    · exact ih h.1 hx
    · exact h.2

theorem imp6_spec {a b : Bool} (h : (!a || b) = true) (ha : a = true) : b = true := by
  subst ha; simpa using h

theorem exactTriple6_lt {m2 m3 m4 : ℕ} (h : ExactTriple6 m2 m3 m4) : m2 < 4 ∧ m3 < 4 ∧ m4 < 4 := by
  unfold ExactTriple6 at h; omega

/-- The atom sizes of the solutions of the seven equations, by kernel evaluation. -/
theorem dispatch6_dec :
  (ball6 4 fun m2 => ball6 4 fun m3 => ball6 4 fun m4 => !decide (ExactTriple6 m2 m3 m4) ||
    ball6 7 fun x5 => !(decide (x5 ≤ m2) &&
      decide (x5 ≤ m3) &&
      decide (x5 ≤ m4)) ||
    ball6 7 fun x10 => !(decide (x10 ≤ m2) &&
      decide (x10 ≤ m3) &&
      decide (x10 ≤ m4) &&
      decide (x10 ≤ 6)) ||
    ball6 7 fun x2 => !(decide (x2 + x10 ≤ m3) && decide (x2 + x10 ≤ m4)) ||
    ball6 7 fun x4 => !(decide (x4 + x5 ≤ m2) && decide (x4 + x5 ≤ m3)) ||
    ball6 7 fun x6 => !(decide (x4 + x5 + x6 ≤ m2) && decide (x2 + x6 + x10 ≤ m4)) ||
    ball6 7 fun x9 => !(decide (x9 + x10 ≤ m2) &&
      decide (x5 + x9 ≤ m4) &&
      decide (x9 + x10 ≤ 6)) ||
    ball6 7 fun x11 => !(decide (x9 + x10 + x11 ≤ m2) &&
      decide (x2 + x10 + x11 ≤ m3) &&
      decide (x9 + x10 + x11 ≤ 6)) ||
    ball6 7 fun x13 => !(decide (x4 + x5 + x13 ≤ m3) &&
      decide (x5 + x9 + x13 ≤ m4) &&
      decide (x9 + x10 + x11 + x13 ≤ 6)) ||
    ball6 7 fun x1 => !(decide (x1 + x5 + x9 + x13 = m4)) ||
    ball6 7 fun x3 => !(decide (x2 + x3 + x10 + x11 = m3)) ||
    ball6 7 fun x7 => !(decide (x4 + x5 + x6 + x7 = m2)) ||
    ball6 7 fun x8 => !(decide (x8 + x9 + x10 + x11 = m2) &&
        decide (x8 + x9 + x10 + x11 + x13 ≤ 6)) ||
    ball6 7 fun x12 => !(decide (x4 + x5 + x12 + x13 = m3) &&
        decide (x8 + x9 + x10 + x11 + x12 + x13 ≤ 6)) ||
    ball6 7 fun x14 => !(decide (x2 + x6 + x10 + x14 = m4) &&
        decide (x8 + x9 + x10 + x11 + x12 + x13 + x14 ≤ 6)) ||
    ball6 7 fun x15 => !(decide (x8 + x9 + x10 + x11 + x12 + x13 + x14 + x15 = 6)) ||
    hit6 [x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15]) = true
  := by decide +kernel

/-- The list sizes and consecutive intersections by atom sizes. -/
theorem venn_lin (B₁ B₂ B₃ B₄ : Finset ℕ) :
    (B₁.card : ℤ) =
      ((atomSet B₁ B₂ B₃ B₄ (true, false, false, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, false, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, false, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, false, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, false, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, true)).card : ℤ) ∧
    (B₂.card : ℤ) =
      ((atomSet B₁ B₂ B₃ B₄ (false, true, false, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, false, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, true)).card : ℤ) ∧
    (B₃.card : ℤ) =
      ((atomSet B₁ B₂ B₃ B₄ (false, false, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, false, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, false, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, false, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, true)).card : ℤ) ∧
    (B₄.card : ℤ) =
      ((atomSet B₁ B₂ B₃ B₄ (false, false, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, false, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, false, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, false, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, true)).card : ℤ) ∧
    ((B₁ ∩ B₂).card : ℤ) =
      ((atomSet B₁ B₂ B₃ B₄ (true, true, false, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, false, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, true)).card : ℤ) ∧
    ((B₂ ∩ B₃).card : ℤ) =
      ((atomSet B₁ B₂ B₃ B₄ (false, true, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, false)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, true)).card : ℤ) ∧
    ((B₃ ∩ B₄).card : ℤ) =
      ((atomSet B₁ B₂ B₃ B₄ (false, false, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (false, true, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, false, true, true)).card : ℤ)
      + ((atomSet B₁ B₂ B₃ B₄ (true, true, true, true)).card : ℤ) := by
  have h := vennOf_eq B₁ B₂ B₃ B₄
  simp only [vennOf, vennFn, Venn.mk.injEq] at h
  obtain ⟨h1, h2, h3, h4, h12, h23, h34, -⟩ := h
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [h1]; simp [vsum, memList]; ring
  · rw [h2]; simp [vsum, memList]; ring
  · rw [h3]; simp [vsum, memList]; ring
  · rw [h4]; simp [vsum, memList]; ring
  · rw [h12]; simp [vsum, memList]; ring
  · rw [h23]; simp [vsum, memList]; ring
  · rw [h34]; simp [vsum, memList]; ring

theorem hit_atoms {B₁ B₂ B₃ B₄ : Finset ℕ}
    (h : hit6 (memList.tail.map fun m => (atomSet B₁ B₂ B₃ B₄ m).card) = true) :
    ∃ sp ∈ table6, AtomsMatch sp B₁ B₂ B₃ B₄ := by
  obtain ⟨sp, hsp, he⟩ := List.any_eq_true.mp h
  refine ⟨sp, hsp, ?_⟩
  have he' := of_decide_eq_true he
  simp only [memList, List.tail_cons, List.map_cons, List.map_nil, List.cons.injEq, and_true]
    at he'
  obtain ⟨e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15⟩ := he'
  intro m hm
  rcases m with ⟨_ | _, _ | _, _ | _, _ | _⟩
  all_goals first
    | exact absurd rfl hm | exact e1.symm | exact e2.symm | exact e3.symm | exact e4.symm
    | exact e5.symm | exact e6.symm | exact e7.symm | exact e8.symm | exact e9.symm
    | exact e10.symm | exact e11.symm | exact e12.symm | exact e13.symm | exact e14.symm
    | exact e15.symm

/-- **The shapes of the small mismatch triples**: their atom sizes are a certificate's. -/
theorem dispatch6 {B₁ B₂ B₃ B₄ : Finset ℕ} {m2 m3 m4 : ℕ} (hs : ExactTriple6 m2 m3 m4)
    (hB₁ : B₁.card = 6) (hB₂ : B₂.card = 6) (hB₃ : B₃.card = 6) (hB₄ : B₄.card = 6)
    (h12 : (B₁ ∩ B₂).card + m2 = 6) (h23 : (B₂ ∩ B₃).card + m3 = 6)
    (h34 : (B₃ ∩ B₄).card + m4 = 6) :
    ∃ sp ∈ table6, AtomsMatch sp B₁ B₂ B₃ B₄ := by
  obtain ⟨l1, l2, l3, l4, l12, l23, l34⟩ := venn_lin B₁ B₂ B₃ B₄
  obtain ⟨u2, u3, u4⟩ := exactTriple6_lt hs
  have h := dispatch6_dec
  have h := ball6_spec h m2 (by omega)
  have h := ball6_spec h m3 (by omega)
  have h := ball6_spec h m4 (by omega)
  have h := imp6_spec h (decide_eq_true hs)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (false, true, false, true)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (true, false, true, false)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (false, false, true, false)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (false, true, false, false)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (false, true, true, false)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (true, false, false, true)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (true, false, true, true)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (true, true, false, true)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (false, false, false, true)).card (by omega)
  have h := imp6_spec h (by simp only [decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (false, false, true, true)).card (by omega)
  have h := imp6_spec h (by simp only [decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (false, true, true, true)).card (by omega)
  have h := imp6_spec h (by simp only [decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (true, false, false, false)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (true, true, false, false)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (true, true, true, false)).card (by omega)
  have h := imp6_spec h (by simp only [Bool.and_eq_true, decide_eq_true_eq]; omega)
  have h := ball6_spec h (atomSet B₁ B₂ B₃ B₄ (true, true, true, true)).card (by omega)
  have h := imp6_spec h (by simp only [decide_eq_true_eq]; omega)
  exact hit_atoms h

