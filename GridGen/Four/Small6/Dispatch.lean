namespace GridGen.Four

/-- The mismatch triples with exact certificates at `k = 6`. -/
def ExactTriple6 (m2 m3 m4 : ℕ) : Prop :=
  (m2 = 0 ∧ m3 = 0 ∧ m4 = 1) ∨
    (m2 = 0 ∧ m3 = 0 ∧ m4 = 2) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 0) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 1) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 2) ∨
    (m2 = 0 ∧ m3 = 2 ∧ m4 = 0) ∨
    (m2 = 0 ∧ m3 = 2 ∧ m4 = 1) ∨
    (m2 = 0 ∧ m3 = 2 ∧ m4 = 2) ∨
    (m2 = 0 ∧ m3 = 3 ∧ m4 = 0) ∨
    (m2 = 0 ∧ m3 = 3 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 0 ∧ m4 = 0) ∨
    (m2 = 1 ∧ m3 = 0 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 1 ∧ m4 = 0) ∨
    (m2 = 1 ∧ m3 = 1 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 2 ∧ m4 = 0) ∨
    (m2 = 2 ∧ m3 = 0 ∧ m4 = 0)

instance (m2 m3 m4 : ℕ) : Decidable (ExactTriple6 m2 m3 m4) := by
  unfold ExactTriple6; infer_instance

theorem exactTriple6_lt {m2 m3 m4 : ℕ} (h : ExactTriple6 m2 m3 m4) :
    m2 < 4 ∧ m3 < 4 ∧ m4 < 4 := by
  unfold ExactTriple6 at h; omega

/-- The atom sizes of the solutions of the seven equations, by kernel evaluation. -/
theorem dispatch6_dec :
    dispatchCheck 6 4 (fun m2 m3 m4 => decide (ExactTriple6 m2 m3 m4)) hit6 = true := by
  decide +kernel

/-- **The shapes of the small mismatch triples**: their atom sizes are a certificate's. -/
theorem dispatch6 {B₁ B₂ B₃ B₄ : Finset ℕ} {m2 m3 m4 : ℕ} (hs : ExactTriple6 m2 m3 m4)
    (hB₁ : B₁.card = 6) (hB₂ : B₂.card = 6) (hB₃ : B₃.card = 6) (hB₄ : B₄.card = 6)
    (h12 : (B₁ ∩ B₂).card + m2 = 6) (h23 : (B₂ ∩ B₃).card + m3 = 6)
    (h34 : (B₃ ∩ B₄).card + m4 = 6) :
    ∃ sp ∈ table6, AtomsMatch sp B₁ B₂ B₃ B₄ :=
  hitIn_atoms (table := table6) (atoms := Spec6.atoms) <|
    dispatch_of_check dispatch6_dec (exactTriple6_lt hs) (decide_eq_true hs)
      hB₁ hB₂ hB₃ hB₄ h12 h23 h34

end GridGen.Four
