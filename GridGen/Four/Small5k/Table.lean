/-- The atom sizes `xs` (of the nonzero atoms, in `memList` order) are those of a certificate. -/
def hit5k (xs : List ℕ) : Bool :=
  table5k.any fun sp => decide (memList.tail.map (asz sp.atoms) = xs)

