import GridGen.Four.Dispatch
import GridGen.Four.Small5k.Table

/-!
# Height four, `k = 5`: the shapes of the exact mismatch triples

Generated by `ai_research_notes/h4k5/lean/gen_exact.py`, then reduced on 2026-10-25 to an instance of
`GridGen/Four/Dispatch.lean`, which is shared by `k = 5` and `k = 6`. Four `5`-lists with
consecutive mismatches `(μ₂, μ₃, μ₄)` (`μᵢ = 5 - |Bᵢ₋₁ ∩ Bᵢ|`) one of the fourteen triples
`ExactTriple5k` have the atom sizes of one of the certificates in `table5k` (`dispatch5k`);
`dispatch5k_dec` checks the enumeration `dispatchCheck` by kernel evaluation.
-/

namespace GridGen.Four

/-- The mismatch triples with exact certificates at `k = 5`. -/
def ExactTriple5k (m2 m3 m4 : ℕ) : Prop :=
  (m2 = 0 ∧ m3 = 0 ∧ m4 = 1) ∨
    (m2 = 0 ∧ m3 = 0 ∧ m4 = 2) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 0) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 1) ∨
    (m2 = 0 ∧ m3 = 1 ∧ m4 = 2) ∨
    (m2 = 0 ∧ m3 = 2 ∧ m4 = 0) ∨
    (m2 = 0 ∧ m3 = 2 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 0 ∧ m4 = 0) ∨
    (m2 = 1 ∧ m3 = 0 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 1 ∧ m4 = 0) ∨
    (m2 = 1 ∧ m3 = 1 ∧ m4 = 1) ∨
    (m2 = 1 ∧ m3 = 2 ∧ m4 = 0) ∨
    (m2 = 2 ∧ m3 = 0 ∧ m4 = 0) ∨
    (m2 = 2 ∧ m3 = 1 ∧ m4 = 0)

instance (m2 m3 m4 : ℕ) : Decidable (ExactTriple5k m2 m3 m4) := by
  unfold ExactTriple5k; infer_instance

theorem exactTriple5k_lt {m2 m3 m4 : ℕ} (h : ExactTriple5k m2 m3 m4) :
    m2 < 3 ∧ m3 < 3 ∧ m4 < 3 := by
  unfold ExactTriple5k at h; omega

/-- The atom sizes of the solutions of the seven equations, by kernel evaluation. -/
theorem dispatch5k_dec :
    dispatchCheck 5 3 (fun m2 m3 m4 => decide (ExactTriple5k m2 m3 m4)) hit5k = true := by
  decide +kernel

/-- **The shapes of the exact mismatch triples**: their atom sizes are a certificate's. -/
theorem dispatch5k {B₁ B₂ B₃ B₄ : Finset ℕ} {m2 m3 m4 : ℕ} (hs : ExactTriple5k m2 m3 m4)
    (hB₁ : B₁.card = 5) (hB₂ : B₂.card = 5) (hB₃ : B₃.card = 5) (hB₄ : B₄.card = 5)
    (h12 : (B₁ ∩ B₂).card + m2 = 5) (h23 : (B₂ ∩ B₃).card + m3 = 5)
    (h34 : (B₃ ∩ B₄).card + m4 = 5) :
    ∃ sp ∈ table5k, AtomsMatch5 sp B₁ B₂ B₃ B₄ :=
  hitIn_atoms (table := table5k) (atoms := Spec5k.atoms) <|
    dispatch_of_check dispatch5k_dec (exactTriple5k_lt hs) (decide_eq_true hs)
      hB₁ hB₂ hB₃ hB₄ h12 h23 h34

end GridGen.Four
