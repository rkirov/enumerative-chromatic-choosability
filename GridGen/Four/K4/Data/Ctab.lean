/-- The clusters of a region. -/
def ctab (q : ℕ) : List (VN × VN) := ctabList.getD q []

theorem ctab_ok0 : ∀ q < 20, ctabQOK ctab (q + 0) = true := by
  decide +kernel

theorem ctab_ok1 : ∀ q < 20, ctabQOK ctab (q + 20) = true := by
  decide +kernel

theorem ctab_ok2 : ∀ q < 20, ctabQOK ctab (q + 40) = true := by
  decide +kernel

theorem ctab_ok3 : ∀ q < 20, ctabQOK ctab (q + 60) = true := by
  decide +kernel

/-- **The cluster table is verified.** -/
theorem ctab_ok : CtabOK ctab := by
  apply ctabOK_of
  intro q hq
  rcases (show q < 20 ∨ (20 ≤ q ∧ q < 40) ∨ (40 ≤ q ∧ q < 60) ∨ (60 ≤ q ∧ q < 80) by omega) with
    h | h | h | h
  · simpa using ctab_ok0 q h
  · simpa [show q - 20 + 20 = q by omega] using ctab_ok1 (q - 20) (by omega)
  · simpa [show q - 40 + 40 = q by omega] using ctab_ok2 (q - 40) (by omega)
  · simpa [show q - 60 + 60 = q by omega] using ctab_ok3 (q - 60) (by omega)

end GridGen.Four.K4
