import Mathlib

set_option maxRecDepth 20000

/-!
# PILOT: existential-witness certificate for seam bounds (codex route D).

Demonstrates the memory-removing architecture: a purely-INTEGER checker verifies each seam's coupling
(left marginals + per-entry fourth-root witness `k` + the bound `R₊⁴·ρ<1` as integer cross-multiplication),
`native_decide` clears real coupling data, and `SeamGood` is an EXISTENTIAL so the kernel `K` is
recovered by `Classical.choose` without materializing entries in the Markov measure.
Entries are (s,t,v,k): v = D·X(s,t) integer coupling value (D=108000), k = E·r₊ (E=10⁶), r₊⁴≥X/α.
-/

namespace Grid3.Three.PilotCert

abbrev Entry := ℕ × ℕ × ℕ × ℕ            -- (s, t, v, k)
abbrev Seam := Array ℕ × ℕ × Array Entry -- (cA left-law counts, nr, support)

def Dc : ℕ := 108000
def Ec : ℕ := 1000000
def SC : ℕ := 1000                        -- D/108

/-- Left marginals: row sums of X equal `cA[s]·(D/108)` (so X/D has left law α=cA/108). -/
def rowOK (cA : Array ℕ) (nr : ℕ) (sup : Array Entry) : Bool :=
  (List.range nr).all (fun s =>
    (sup.foldl (fun acc e => if e.1 = s then acc + e.2.2.1 else acc) 0) == cA[s]! * SC)

/-- Per-entry fourth-root witness: `(k/E)⁴ ≥ X(s,t)/α(s)`, i.e. `k⁴·D·cA[s] ≥ v·108·E⁴`. -/
def entryOK (cA : Array ℕ) (sup : Array Entry) : Bool :=
  sup.all (fun e => e.2.2.2 ^ 4 * (Dc * cA[e.1]!) ≥ e.2.2.1 * 108 * (Ec ^ 4))

/-- `R₊ = (Σ v·k)/(D·E)`; the bound `R₊⁴·ρ < 1` as integer cross-multiplication (ρ=(5+√17)/2). -/
def boundOK (sup : Array Entry) : Bool :=
  let NR := sup.foldl (fun acc e => acc + e.2.2.1 * e.2.2.2) 0
  let Dr := Dc * Ec
  (5 * NR ^ 4 < 2 * Dr ^ 4) && (17 * NR ^ 8 < (2 * Dr ^ 4 - 5 * NR ^ 4) ^ 2)

def checkSeam (d : Seam) : Bool := rowOK d.1 d.2.1 d.2.2 && entryOK d.1 d.2.2 && boundOK d.2.2

/-- A seam is GOOD if some coupling witness passes every exact check. -/
def SeamGood (d : Seam) : Prop := ∃ X : Array Entry, checkSeam (d.1, d.2.1, X) = true

