/-- **Every pilot seam passes the exact checker** (compiled). -/
theorem pilot_check : pilotData.all checkSeam = true := by native_decide

/-- **Every pilot seam is GOOD** — the existential form; witnesses come from the (private) data. -/
theorem pilot_all_good : ∀ d ∈ pilotData, SeamGood d := by
  have h : ∀ d ∈ pilotData, checkSeam d = true := by native_decide
  exact fun d hd => ⟨d.2.2, h d hd⟩

/-- **Existential erasure:** the kernel witness is recovered by `Classical.choose` — noncomputable,
    never materializing entries. This is what the Markov measure `K` uses. -/
noncomputable def Kwitness (d : Seam) (hd : d ∈ pilotData) : Array Entry :=
  Classical.choose (pilot_all_good d hd)

theorem Kwitness_spec (d : Seam) (hd : d ∈ pilotData) :
    checkSeam (d.1, d.2.1, Kwitness d hd) = true :=
  Classical.choose_spec (pilot_all_good d hd)

end Grid3.Three.PilotCert
