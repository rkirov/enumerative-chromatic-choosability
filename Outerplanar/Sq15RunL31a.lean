/-- **L31a** (fifteen-face note, five marks, (3|1)): `[AB_f, Z, 1] → B`. -/
theorem sq_L31a_ball {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ}
    (hLu : Lu.card = 3) (hLv : Lv.card = 3) (hLi : ∀ j, (Li j).card = 3)
    {W : Fin 3 → ℕ → ℕ → ℝ} (hW : ∀ j c d, 0 ≤ W j c d) {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : ClsABf Lu (Li 0) (W 0) (N 0))
    (h1 : ClsZ (Li 0) (Li 1) (W 1) (N 1))
    (h2 : Dominant (Li 1) Lv (W 2) (N 2)) :
    InBall Lu Lv (faceSum Li (fun _ _ => 1) W) (3 * (N 0 * N 1 * N 2)) := by
  have h := sq_ball_of_good' good_L31a hLu hLv hLi hW hN h0.lcls h1.lcls (m1_lcls h2)
  convert h using 1
  push_cast
  ring

/-- The reflection of `sq_L31a_ball`: the classes `1, Z, ABf` on the path edges 0, 1, 2. -/
theorem sq_L31a_ball_rev {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ}
    (hLu : Lu.card = 3) (hLv : Lv.card = 3) (hLi : ∀ j, (Li j).card = 3)
    {W : Fin 3 → ℕ → ℕ → ℝ} (hW : ∀ j c d, 0 ≤ W j c d) {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : Dominant Lu (Li 0) (W 0) (N 0))
    (h1 : ClsZ (Li 0) (Li 1) (W 1) (N 1))
    (h2 : ClsABf (Li 1) Lv (W 2) (N 2)) :
    InBall Lu Lv (faceSum Li (fun _ _ => 1) W) (3 * (N 0 * N 1 * N 2)) := by
  have h := sq_L31a_ball (Lu := Lv) (Lv := Lu) (Li := revL Li) (W := revW W) (N := revN N)
    hLv hLu (revL_card hLi) (revW_nonneg hW) (revN_pos hN) h2.swap h1.swap h0.swap
  rw [revN_prod] at h
  exact inBall_rev h

