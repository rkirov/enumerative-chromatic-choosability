/-- **`[B, M, M] → H`** (thirteen-face note, Lemma 1(1)): the ball class on the path edge 0 and the
matching class on the edges 1, 2 give the hexagon bound at scale 1. -/
theorem sq_BMM_hex {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ} (hLv : Lv.card = 3)
    (hLi : ∀ j, (Li j).card = 3) {W : Fin 3 → ℕ → ℕ → ℝ} (hW : ∀ j c d, 0 ≤ W j c d)
    {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : InBall Lu (Li 0) (W 0) (N 0))
    (h1 : BijGe (Li 0) (Li 1) (W 1) (N 1) 1)
    (h2 : BijGe (Li 1) Lv (W 2) (N 2) 1) :
    Hex Lu Lv (faceSum Li (fun _ _ => 1) W) (3 * (N 0 * N 1 * N 2)) := by
  have h := sq_hex_of_good (Lu := Lu) good_BMM hLv hLi hW hN
    (by rw [show dig 2 20 0 = 0 from rfl, sqClass_zero]; exact h0)
    (by rw [show dig 2 20 1 = 1 from rfl, sqClass_one]; exact h1)
    (by rw [show dig 2 20 2 = 1 from rfl, sqClass_one]; exact h2)
  convert h using 1
  push_cast
  ring

