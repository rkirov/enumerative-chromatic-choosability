/-- **The two-distinguished law, `[M, H, M] → K⁻¹ H`** (`square_two_heavy.py`, `passes`): the
hexagon class on the path edge 1 and the matching class on the edges 0, 2 give the hexagon bound at
scale `56/59`. -/
theorem sq_MHM_hex {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ} (hLv : Lv.card = 3)
    (hLi : ∀ j, (Li j).card = 3) {W : Fin 3 → ℕ → ℕ → ℝ} (hW : ∀ j c d, 0 ≤ W j c d)
    {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : BijGe Lu (Li 0) (W 0) (N 0) 1)
    (h1 : Hex (Li 0) (Li 1) (W 1) (N 1))
    (h2 : BijGe (Li 1) Lv (W 2) (N 2) 1) :
    Hex Lu Lv (faceSum Li (fun _ _ => 1) W) (3 * (56 / 59) * (N 0 * N 1 * N 2)) := by
  have h := sq_hex_of_good (Lu := Lu) good_MHM hLv hLi hW hN
    (by rw [show dig 2 25 0 = 1 from rfl, sqClass_one]; exact h0)
    (by rw [show dig 2 25 1 = 2 from rfl, sqClass_two]; exact h1)
    (by rw [show dig 2 25 2 = 1 from rfl, sqClass_one]; exact h2)
  convert h using 1
  push_cast
  ring

