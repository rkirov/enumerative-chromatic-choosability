/-- **`three_heavy`** (`square_two_heavy.py`): the hexagon class on all three path edges gives the
closing count (the colourings with different colours at `u` and `v`) at least `18 (16/17)³ N₀ N₁
N₂`. -/
theorem sq_HHH_close {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ} (hLu : Lu.card = 3)
    (hLv : Lv.card = 3) (hLi : ∀ j, (Li j).card = 3) {W : Fin 3 → ℕ → ℕ → ℝ}
    (hW : ∀ j c d, 0 ≤ W j c d) {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : Hex Lu (Li 0) (W 0) (N 0))
    (h1 : Hex (Li 0) (Li 1) (W 1) (N 1))
    (h2 : Hex (Li 1) Lv (W 2) (N 2)) :
    18 * (16 / 17) ^ 3 * (N 0 * N 1 * N 2)
      ≤ ∑ x ∈ Lu, ∑ y ∈ Lv, if x = y then 0 else faceSum Li (fun _ _ => 1) W x y := by
  have h := sq_close_of_good (Lu := Lu) good_HHHc hLu hLv hLi hW hN
    (by rw [show dig 2 42 0 = 2 from rfl, sqClass_two]; exact h0)
    (by rw [show dig 2 42 1 = 2 from rfl, sqClass_two]; exact h1)
    (by rw [show dig 2 42 2 = 2 from rfl, sqClass_two]; exact h2)
  convert h using 1
  push_cast
  ring

