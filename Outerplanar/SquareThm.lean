import Outerplanar.SqData.Table

/-!
# Squares with one loaded edge preserve the ball class

The ball invariant (`InBall`, `Outerplanar/Ball.lean`) is preserved by triangles
(`ballTriClosed`, `Outerplanar/OneLoad.lean`) and, by the certificates of
`Outerplanar/SqData/`, by squares with one loaded edge:

* `sqCover` — the covering statement for squares: 52 patterns of equal colours, each with a
  certificate for each of the three positions of the loaded edge (7650 instances in all), and a
  table that puts every pattern of four lists below one of the 52;
* `ballFaceBare_two` — squares preserve the ball class.

The closure for longer faces, and the theorem on graphs, are in `Outerplanar/LongFace.lean`.

This is a result of this repository's 2026-11 AI research collaboration (research log
`ai_research_notes/OUTERPLANAR_K3_TRIANGLES_2026-11-10.md`, section "Twelfth pass"). The
certificates are generated by `ai_research_notes/outerplanar/lean_sq/gen.py` and `emit.py`.
-/

namespace Outerplanar

/-- The covering statement for squares, from the certificates of `Outerplanar/SqData/`. -/
theorem sqCover : SqCover := sqCover_of_table SqData.sqOK_all SqData.chunk_all

/-- **Squares preserve the ball class.** -/
theorem ballFaceBare_two : BallFaceBare 2 := ballFaceBare_two_of_cover sqCover

end Outerplanar
