/-- **N1** (fifteen-face note, seven marks, (3,3) adjacent): `[AB_f, AB_f, 1] → D₆ H`. -/
theorem sq_N1_hex {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ}
    (hLv : Lv.card = 3) (hLi : ∀ j, (Li j).card = 3)
    {W : Fin 3 → ℕ → ℕ → ℝ} (hW : ∀ j c d, 0 ≤ W j c d) {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : ClsABf Lu (Li 0) (W 0) (N 0))
    (h1 : ClsABf (Li 0) (Li 1) (W 1) (N 1))
    (h2 : Dominant (Li 1) Lv (W 2) (N 2)) :
    Hex Lu Lv (faceSum Li (fun _ _ => 1) W) (3 * d6 * (N 0 * N 1 * N 2)) := by
  have h := sq_hex_of_good' good_N1 hLv hLi hW hN h0.lcls h1.lcls (m1_lcls h2)
  have hp : 0 < N 0 * N 1 * N 2 := by
    have := hN 0
    have := hN 1
    have := hN 2
    positivity
  refine Hex.weaken (by have := d6_pos; positivity) ?_ h
  have hd := d6_le_103
  push_cast
  nlinarith

/-- The reflection of `sq_N1_hex`: the classes `1, ABf, ABf` on the path edges 0, 1, 2. -/
theorem sq_N1_hex_rev {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ}
    (hLu : Lu.card = 3) (hLi : ∀ j, (Li j).card = 3)
    {W : Fin 3 → ℕ → ℕ → ℝ} (hW : ∀ j c d, 0 ≤ W j c d) {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : Dominant Lu (Li 0) (W 0) (N 0))
    (h1 : ClsABf (Li 0) (Li 1) (W 1) (N 1))
    (h2 : ClsABf (Li 1) Lv (W 2) (N 2)) :
    Hex Lu Lv (faceSum Li (fun _ _ => 1) W) (3 * d6 * (N 0 * N 1 * N 2)) := by
  have h := sq_N1_hex (Lu := Lv) (Lv := Lu) (Li := revL Li) (W := revW W) (N := revN N)
    hLu (revL_card hLi) (revW_nonneg hW) (revN_pos hN) h2.swap h1.swap h0.swap
  rw [revN_prod] at h
  exact hex_rev h

