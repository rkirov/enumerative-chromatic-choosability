/-- **U1a** (fifteen-face note, centroid {3, 4, 7H}): the closing of `[AB_f, BAH_f, H7_f]`. -/
theorem sq_U1a_close {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ}
    (hLu : Lu.card = 3) (hLv : Lv.card = 3) (hLi : ∀ j, (Li j).card = 3)
    {W : Fin 3 → ℕ → ℕ → ℝ} (hW : ∀ j c d, 0 ≤ W j c d) {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : ClsABf Lu (Li 0) (W 0) (N 0))
    (h1 : ClsBAHf (Li 0) (Li 1) (W 1) (N 1))
    (h2 : ClsH7f (Li 1) Lv (W 2) (N 2)) :
    18 * (N 0 * N 1 * N 2)
      ≤ ∑ x ∈ Lu, ∑ y ∈ Lv, if x = y then 0 else faceSum Li (fun _ _ => 1) W x y := by
  have h := sq_close_of_good' good_U1a hLu hLv hLi hW hN h0.lcls h1.lcls h2.lcls
  convert h using 1
  push_cast
  ring

