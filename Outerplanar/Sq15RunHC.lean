/-- The reflection of `sq_U3_close`: the classes `Bf5, Bf5, BAHf` on the path edges 0, 1, 2. -/
theorem sq_U3_close_rev {Lu Lv : Finset ℕ} {Li : Fin 2 → Finset ℕ}
    (hLu : Lu.card = 3) (hLv : Lv.card = 3) (hLi : ∀ j, (Li j).card = 3)
    {W : Fin 3 → ℕ → ℕ → ℝ} (hW : ∀ j c d, 0 ≤ W j c d) {N : Fin 3 → ℝ} (hN : ∀ j, 0 < N j)
    (h0 : ClsBf5 Lu (Li 0) (W 0) (N 0))
    (h1 : ClsBf5 (Li 0) (Li 1) (W 1) (N 1))
    (h2 : ClsBAHf (Li 1) Lv (W 2) (N 2)) :
    18 * (N 0 * N 1 * N 2)
      ≤ ∑ x ∈ Lu, ∑ y ∈ Lv, if x = y then 0 else faceSum Li (fun _ _ => 1) W x y := by
  have h := sq_U3_close (Lu := Lv) (Lv := Lu) (Li := revL Li) (W := revW W) (N := revN N)
    hLv hLu (revL_card hLi) (revW_nonneg hW) (revN_pos hN) h2.swap h1.swap h0.swap
  rw [revN_prod] at h
  exact close_rev h

