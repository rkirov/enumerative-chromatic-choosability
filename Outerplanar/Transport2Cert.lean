import Outerplanar.Transport

/-!
# Base certificates for the transport through two loaded steps

For a path of four steps whose loaded steps are separated into segments of lengths
`(j, g, s)` with `j + g + s = 2`, and each bijection `σ` of the three indices, five pairs of
bijections `(tpAₚ σ t, tpBₚ σ t)` of the six cells such that each root cell `k` uses the pair of
cells `(tpA k, tpB k)` at most as often as there are walks from `(offPair k).1` to
`σ (offPair k).2` through those two cells at the two loaded steps (`cert_ok`).
The tables were found by `ai_research_notes/outerplanar/sixeven_lean/two_base_perms.py`; they
are checked here by the kernel. They are the base cases of `exists_bd_le` in
`Outerplanar/Transport2.lean`.
-/

namespace Outerplanar

/-- The index of a bijection of `Fin 3`, in the order of `bperm`. -/
def sigIdx (σ : Fin 3 → Fin 3) : Fin 6 :=
  if σ 0 = 0 ∧ σ 1 = 1 then 0 else if σ 0 = 0 ∧ σ 1 = 2 then 1
  else if σ 0 = 1 ∧ σ 1 = 0 then 2 else if σ 0 = 1 ∧ σ 1 = 2 then 3
  else if σ 0 = 2 ∧ σ 1 = 0 then 4 else 5

/-- The walks from the root cell `k` through the cells `z`, `w` at the two loaded steps, with
`j`, `g`, `s` steps before, between and after them. -/
def C2N (j g s : ℕ) (σ : Fin 3 → Fin 3) (k z w : Fin 6) : ℕ :=
  cnt j (offPair k).1 (offPair z).1 * cnt g (offPair z).2 (offPair w).1 *
    cnt s (offPair w).2 (σ (offPair k).2)

/-- How many of the five pairs agree with the pair `t` at the root cell `k`. -/
def mult5 (fA fB : Fin 5 → Fin 6 → Fin 6) (k : Fin 6) (t : Fin 5) : ℕ :=
  (if fA 0 k = fA t k ∧ fB 0 k = fB t k then 1 else 0) +
  (if fA 1 k = fA t k ∧ fB 1 k = fB t k then 1 else 0) +
  (if fA 2 k = fA t k ∧ fB 2 k = fB t k then 1 else 0) +
  (if fA 3 k = fA t k ∧ fB 3 k = fB t k then 1 else 0) +
  (if fA 4 k = fA t k ∧ fB 4 k = fB t k then 1 else 0)

